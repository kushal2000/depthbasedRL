#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=2
#SBATCH --get-user-env
#SBATCH --mem=8000
#SBATCH -t 0-00:20:00
#SBATCH --partition=portal
#SBATCH -J snapshot_latest_evals
#SBATCH -o /share/portal/kk837/depthbasedRL/plot_figures/rebuttal/experiments/logs/snapshot_latest_evals_%j.out
#SBATCH -e /share/portal/kk837/depthbasedRL/plot_figures/rebuttal/experiments/logs/snapshot_latest_evals_%j.err

# Freeze the live checkpoints used by the latest rebuttal offline evaluations.
# Downstream GPU jobs depend on this job, so every task sees a stable policy.

set -euo pipefail

: "${SNAPSHOT_TAG:?set SNAPSHOT_TAG}"

REPO_ROOT=/share/portal/kk837/depthbasedRL
OUT_DIR="$REPO_ROOT/train_dir/eval_snapshots/$SNAPSHOT_TAG"
mkdir -p "$OUT_DIR" "$REPO_ROOT/plot_figures/rebuttal/experiments/logs"

copy_checkpoint () {
  local label="$1" source="$2" target="$3"
  local before after attempt tmp
  if [ ! -s "$source" ]; then
    echo "missing checkpoint for $label: $source" >&2
    exit 1
  fi
  tmp="${target}.tmp.$$"
  for attempt in 1 2 3; do
    before="$(stat -c '%s:%y' "$source")"
    cp --reflink=auto "$source" "$tmp"
    after="$(stat -c '%s:%y' "$source")"
    if [ "$before" = "$after" ] && [ "$(stat -c '%s' "$tmp")" -gt 200000000 ]; then
      mv "$tmp" "$target"
      printf '%s\t%s\t%s\n' "$label" "$before" "$source" >> "$OUT_DIR/manifest.tsv"
      return 0
    fi
    rm -f "$tmp"
    sleep 2
  done
  echo "checkpoint changed during all snapshot attempts: $source" >&2
  exit 1
}

: > "$OUT_DIR/manifest.tsv"

copy_checkpoint unified_fixed1mm \
  "$REPO_ROOT/train_dir/multiproblem/cotrain/multiproblem_4way_peg1mm_2026-08-09_16-22-10/0_multiproblem_4way_peg1mm_2026-08-09_16-22-10/last/model.pth" \
  "$OUT_DIR/unified_fixed1mm.pth"
copy_checkpoint solo_unbolted_lpeg1mm \
  "$REPO_ROOT/train_dir/multiproblem/cotrain/solo_unbolted_peg1mm_2026-08-09_16-25-22/0_solo_unbolted_peg1mm_2026-08-09_16-25-22/last/model.pth" \
  "$OUT_DIR/solo_unbolted_lpeg1mm.pth"
copy_checkpoint solo_unbolted_beam_step1 \
  "$REPO_ROOT/train_dir/multiproblem/cotrain/solo_unbolted_beam1_2026-08-09_22-17-27/0_solo_unbolted_beam1_2026-08-09_22-17-27/last/model.pth" \
  "$OUT_DIR/solo_unbolted_beam_step1.pth"
copy_checkpoint solo_unbolted_beam_step2 \
  "$REPO_ROOT/train_dir/multiproblem/cotrain/solo_unbolted_beam2_2026-08-09_22-17-27/0_solo_unbolted_beam2_2026-08-09_22-17-27/last/model.pth" \
  "$OUT_DIR/solo_unbolted_beam_step2.pth"
copy_checkpoint solo_unbolted_furniture \
  "$REPO_ROOT/train_dir/multiproblem/cotrain/solo_unbolted_screwleg_2026-08-09_22-17-57/0_solo_unbolted_screwleg_2026-08-09_22-17-57/last/model.pth" \
  "$OUT_DIR/solo_unbolted_furniture.pth"
copy_checkpoint fork_1mm \
  "$REPO_ROOT/train_dir/rebuttal/plug_fork_teachers/fork_tol1mm_finetune_rgf0_dr_wrench_2026-08-07_17-20-42/0_fork_tol1mm_finetune_rgf0_dr_wrench_2026-08-07_17-20-42/last/model.pth" \
  "$OUT_DIR/fork_1mm.pth"
copy_checkpoint plug_0p5mm \
  "$REPO_ROOT/train_dir/rebuttal/plug_fork_teachers/plug_tol0p5mm_finetune_rgf0_dr_wrench_2026-08-09_14-27-09/0_plug_tol0p5mm_finetune_rgf0_dr_wrench_2026-08-09_14-27-09/last/model.pth" \
  "$OUT_DIR/plug_0p5mm.pth"

echo "snapshot complete: $OUT_DIR"
