#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=12
#SBATCH --get-user-env
#SBATCH --mem=200000
#SBATCH -t 0-04:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -J eval_plot_refresh
#SBATCH -o /share/portal/kk837/depthbasedRL/plot_figures/rebuttal/experiments/logs/%x_%j.out
#SBATCH -e /share/portal/kk837/depthbasedRL/plot_figures/rebuttal/experiments/logs/%x_%j.err

# Generic singleton-task offline eval. Required variables are passed through
# sbatch --export by the scheduling command.

set -uo pipefail

: "${EVAL_CHECKPOINT:?set EVAL_CHECKPOINT}"
: "${EVAL_TRAIN_OVERRIDES:?set EVAL_TRAIN_OVERRIDES}"
: "${EVAL_PROBLEM:?set EVAL_PROBLEM}"
: "${EVAL_FIXTURE_BOLTED:?set EVAL_FIXTURE_BOLTED}"
: "${EVAL_MAX_STEPS:?set EVAL_MAX_STEPS}"
: "${EVAL_OUT_DIR:?set EVAL_OUT_DIR}"
: "${EVAL_OUTPUT_STEM:?set EVAL_OUTPUT_STEM}"

REPO_ROOT=/share/portal/kk837/depthbasedRL
EVAL_JOB_TAG="${EVAL_JOB_TAG:-${SLURM_JOB_ID:-local}}"
OUTPUT_JSON="$EVAL_OUT_DIR/${EVAL_OUTPUT_STEM}_job${EVAL_JOB_TAG}.json"
DETAIL_LOG="$EVAL_OUT_DIR/${EVAL_OUTPUT_STEM}_job${EVAL_JOB_TAG}.log"

mkdir -p "$EVAL_OUT_DIR" "$REPO_ROOT/plot_figures/rebuttal/experiments/logs"
cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache_plot_refresh_${EVAL_JOB_TAG}"
mkdir -p "$OMNI_KIT_CACHE_PATH"

if [ ! -s "$EVAL_CHECKPOINT" ]; then
  echo "missing scheduled snapshot: $EVAL_CHECKPOINT" >&2
  exit 1
fi

python -u peg_in_hole_dynamic/offline_eval_teacher_robustness.py \
  --teacher-checkpoint "$EVAL_CHECKPOINT" \
  --train-overrides "$EVAL_TRAIN_OVERRIDES" \
  --exact-train --num-envs 512 --seed 42 \
  --max-steps-per-episode "$EVAL_MAX_STEPS" \
  --override "env.peg_in_hole.problems=[$EVAL_PROBLEM]" \
  --override "env.peg_in_hole.fixture_bolted=$EVAL_FIXTURE_BOLTED" \
  --override env.peg_in_hole.random_goal_fraction=0.0 \
  --override env.domain_randomization.force_scale=0.0 \
  --override env.domain_randomization.torque_scale=0.0 \
  --output-json "$OUTPUT_JSON" > "$DETAIL_LOG" 2>&1 &
EVAL_PID=$!

POLL_LIMIT=180
[ "$EVAL_MAX_STEPS" -gt 600 ] && POLL_LIMIT=360
COMPLETED=0
for _ in $(seq 1 "$POLL_LIMIT"); do
  if grep -q "=> wrote" "$DETAIL_LOG" 2>/dev/null; then COMPLETED=1; break; fi
  kill -0 "$EVAL_PID" 2>/dev/null || break
  sleep 10
done
kill -9 "$EVAL_PID" 2>/dev/null || true
wait "$EVAL_PID" 2>/dev/null || true

grep -E "fixture_bolted|problem=|all envs|no early drop|terminations:|Traceback|Error|=> wrote" "$DETAIL_LOG" || true
if [ "$COMPLETED" -ne 1 ] || [ ! -s "$OUTPUT_JSON" ]; then
  echo "FAILED: evaluation did not produce $OUTPUT_JSON" >&2
  exit 1
fi
jq -r '.results[0] | "RESULT all_envs insertion=\(.all_envs.insertion_rate) retract=\(.all_envs.retract_rate); filtered insertion=\(.early_drop_filtered.insertion_rate) retract=\(.early_drop_filtered.retract_rate); n=\(.early_drop_filtered.n); unfinished=\(.unfinished_envs)"' "$OUTPUT_JSON"
