#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=12
#SBATCH --get-user-env
#SBATCH --mem=200000
#SBATCH -t 3-00:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# Rebuttal teacher: FORK into a flatware holder, at real-world scale.
#
# Reviewers noted the existing task suite uses ENLARGED geometry (beam_3x is
# literally 3x) rather than everyday object sizes. This task is a real scanned
# object at true scale: YCB 030_fork, 197.6 x 27.1 x 15.9 mm, inserted
# HANDLE-FIRST into a moulded holder with 1.00 mm clearance per side.
#
# Asset notes (see peg_in_hole_dynamic/plug_fork/create_assets.py):
#   visual    the YCB scan with its own texture
#   collision 9 CoACD hulls, +15% volume. Axis-aligned slab boxes were tried
#             first and more than DOUBLED it (46.5 vs 19.6 cm^3) by filling the
#             dished head solid -- unusable at 1 mm clearance.
#   holder    procedural, so its 5 box collisions are exact, not approximate.
#   frame     long axis on X with the handle at -X, per repo convention:
#             reward.fixed_size and Object.scale both define keypoints along X,
#             so a Z-long object gets a keypoint box rotated 90 deg to the mesh.
#
# The angular tolerance is the real difficulty here, not the linear one: with
# ~78 mm of engagement and 2 mm of total diametral clearance, the fork binds at
# about 1.5 deg of tilt (atan(2/78)).
#
# Otherwise mirrors the fig-4 teachers: preInsertAndFinal goals, SAPG finetune
# from the shared pretrained checkpoint, full DR, perturbation forces ON.

TASK_ID="Isaacsimenvs-PegInHole-Direct-v0"
AGENT_KEY="rl_games_sapg_cfg_entry_point"
PROBLEM="fork.tol1mm"
GOAL_MODE="preInsertAndFinal"
CHECKPOINT="${CHECKPOINT:-/share/portal/kk837/depthbasedRL/pretrained_policy/model.pth}"

# ── Training scale ───────────────────────────────────────────
NUM_ENVS=12288
MINIBATCH_SIZE=98304
MAX_ITERATIONS=1000000
SEED=0
EXPL_COEF_BLOCK_SIZE=2048

# ── Peg-in-hole goal/tolerance knobs (match the _dr teacher) ─
GOAL_XY_OBS_NOISE=0.002
GOAL_YAW_OBS_NOISE_DEG=1.0
RANDOM_GOAL_FRACTION=0.0
RANDOM_GOAL_MAX_SUCCESSES=5
# Tightened from the fig-4 default of 0.010. The metric threshold is
# insertion_success_tolerance * reward.keypoint_scale (1.5), so 0.010 would mean
# 15 mm on a task whose clearance is 1 mm -- success would fire without the fork
# entering the slot. 0.002 gives a 3 mm threshold.
INSERTION_SUCCESS_TOLERANCE=0.002
# The holder slot is rectangular and near-square in cross-section
# (17.4 x 20.7 mm), so a large hole yaw would demand the policy resolve an
# orientation the geometry barely distinguishes. Keep the fig-4 value.
HOLE_YAW_RANGE_DEG=10.0
SUCCESS_TOLERANCE=0.01
TARGET_SUCCESS_TOLERANCE=0.002
SUCCESS_STEPS=1
ENABLE_RETRACT=True
RETRACT_REWARD_SCALE=1.0
RETRACT_DISTANCE_THRESHOLD=0.1
RETRACT_SUCCESS_TOLERANCE=0.003

# ── Domain randomization (FULL — the `_dr` variant) ──────────
USE_OBS_DELAY=True
USE_ACTION_DELAY=True
USE_OBJECT_STATE_DELAY_NOISE=True
OBJECT_STATE_XYZ_NOISE_STD=0.01
OBJECT_STATE_ROTATION_NOISE_DEG=5.0
JOINT_VELOCITY_OBS_NOISE_STD=0.1
OBJECT_SCALE_NOISE_RANGE="[0.9,1.1]"

# Force/torque perturbations ON. Without the only_when_lifted=False
# overrides, both gates would zero every impulse: in preInsertAndFinal
# the peg starts ~25 cm above the table and the goals pull it down, so
# _lifted_object (which needs ~10 cm of rise above init) never latches.
FORCE_SCALE=20.0
TORQUE_SCALE=2.0
FORCE_ONLY_WHEN_LIFTED=False
TORQUE_ONLY_WHEN_LIFTED=False

# ── Reset / reward knobs ─────────────────────────────────────
RESET_POSITION_NOISE_X=0.1
RESET_POSITION_NOISE_Y=0.1
RESET_POSITION_NOISE_Z=0.02
RESET_DOF_POS_NOISE_ARM=0.1
RESET_DOF_POS_NOISE_FINGERS=0.1
RESET_DOF_VEL_NOISE=0.5
TABLE_RESET_Z_RANGE=0.01
LIFTING_REW_SCALE=20.0
LIFTING_BONUS=300.0
FORCE_CONSECUTIVE_NEAR_GOAL=True

# ── Weights & Biases ─────────────────────────────────────────
WANDB_PROJECT="rebuttal"
WANDB_GROUP="plug_fork_teachers"
EXPERIMENT_TAG="fork_tol1mm_finetune_rgf0_dr_wrench"

# ── Pose-only interactive viewer ─────────────────────────────
CAPTURE_VIEWER_LEN=600
CAPTURE_VIEWER_INTERVAL=6000
CAPTURE_VIEWER_ENV_ID=0
CAPTURE_VIEWER_WANDB_KEY="interactive_viewer"

set -euo pipefail

REPO_ROOT="/share/portal/kk837/depthbasedRL"
if [ ! -f "$CHECKPOINT" ]; then
    echo "Checkpoint not found: $CHECKPOINT" >&2
    exit 1
fi

DATETIME=$(date +"%Y-%m-%d_%H-%M-%S")
EXPERIMENT_NAME="${EXPERIMENT_TAG}_${DATETIME}"
if [ -n "${SLURM_JOB_ID:-}" ]; then
    scontrol update JobId="$SLURM_JOB_ID" JobName="$EXPERIMENT_NAME" || true
fi
HYDRA_RUN_DIR="${REPO_ROOT}/train_dir/${WANDB_PROJECT}/${WANDB_GROUP}/${EXPERIMENT_NAME}"
mkdir -p "$HYDRA_RUN_DIR"
exec > "${HYDRA_RUN_DIR}/slurm.log" 2> "${HYDRA_RUN_DIR}/slurm.err"

echo "=== Initial GPU State ==="
nvidia-smi
echo ""
echo "Checkpoint: $CHECKPOINT"
echo "Run dir:    $HYDRA_RUN_DIR"
echo "Problem:    $PROBLEM"
echo ""

GPU_LOG="${HYDRA_RUN_DIR}/gpu_usage.log"
(
    while true; do
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$GPU_LOG"
        nvidia-smi --query-gpu=memory.used,memory.total,memory.free,utilization.gpu,temperature.gpu \
            --format=csv,noheader >> "$GPU_LOG" 2>&1
        sleep 30
    done
) &
GPU_MONITOR_PID=$!

RAM_LOG="${HYDRA_RUN_DIR}/ram_usage.log"
(
    while true; do
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$RAM_LOG"
        free -m | head -2 >> "$RAM_LOG" 2>&1
        ps -eo pid,rss,comm --sort=-rss --no-headers 2>/dev/null | head -5 >> "$RAM_LOG"
        if [ -n "${SLURM_JOB_ID:-}" ] && command -v sstat >/dev/null 2>&1; then
            sstat -j "$SLURM_JOB_ID" --format=MaxRSS,AveRSS --noheader 2>/dev/null >> "$RAM_LOG" || true
        fi
        sleep 30
    done
) &
RAM_MONITOR_PID=$!

trap "kill $GPU_MONITOR_PID $RAM_MONITOR_PID 2>/dev/null" EXIT

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache"
mkdir -p "$OMNI_KIT_CACHE_PATH"

python -u isaacsimenvs/train.py \
    --task "$TASK_ID" \
    --agent "$AGENT_KEY" \
    --checkpoint "$CHECKPOINT" \
    --checkpoint_load_mode weights \
    --headless \
    --capture_viewer \
    --capture_viewer_len "$CAPTURE_VIEWER_LEN" \
    --capture_viewer_interval "$CAPTURE_VIEWER_INTERVAL" \
    --capture_viewer_env_id "$CAPTURE_VIEWER_ENV_ID" \
    --capture_viewer_wandb_key "$CAPTURE_VIEWER_WANDB_KEY" \
    --wandb_activate \
    --wandb_project "$WANDB_PROJECT" \
    --wandb_group "$WANDB_GROUP" \
    --wandb_entity kk837 \
    --wandb_name "$EXPERIMENT_NAME" \
    env.scene.num_envs=$NUM_ENVS \
    env.peg_in_hole.problem="$PROBLEM" \
    env.peg_in_hole.goal_mode="$GOAL_MODE" \
    env.peg_in_hole.goal_xy_obs_noise=$GOAL_XY_OBS_NOISE \
    env.peg_in_hole.goal_yaw_obs_noise_deg=$GOAL_YAW_OBS_NOISE_DEG \
    env.peg_in_hole.random_goal_fraction=$RANDOM_GOAL_FRACTION \
    env.peg_in_hole.random_goal_max_successes=$RANDOM_GOAL_MAX_SUCCESSES \
    env.peg_in_hole.insertion_success_tolerance=$INSERTION_SUCCESS_TOLERANCE \
    env.peg_in_hole.hole_yaw_range_deg=$HOLE_YAW_RANGE_DEG \
    env.termination.success_tolerance=$SUCCESS_TOLERANCE \
    env.termination.target_success_tolerance=$TARGET_SUCCESS_TOLERANCE \
    env.termination.success_steps=$SUCCESS_STEPS \
    env.peg_in_hole.enable_retract=$ENABLE_RETRACT \
    env.peg_in_hole.retract_reward_scale=$RETRACT_REWARD_SCALE \
    env.peg_in_hole.retract_distance_threshold=$RETRACT_DISTANCE_THRESHOLD \
    env.peg_in_hole.retract_success_tolerance=$RETRACT_SUCCESS_TOLERANCE \
    env.domain_randomization.force_scale=$FORCE_SCALE \
    env.domain_randomization.torque_scale=$TORQUE_SCALE \
    env.domain_randomization.force_only_when_lifted=$FORCE_ONLY_WHEN_LIFTED \
    env.domain_randomization.torque_only_when_lifted=$TORQUE_ONLY_WHEN_LIFTED \
    env.domain_randomization.use_obs_delay=$USE_OBS_DELAY \
    env.domain_randomization.use_action_delay=$USE_ACTION_DELAY \
    env.domain_randomization.use_object_state_delay_noise=$USE_OBJECT_STATE_DELAY_NOISE \
    env.domain_randomization.object_state_xyz_noise_std=$OBJECT_STATE_XYZ_NOISE_STD \
    env.domain_randomization.object_state_rotation_noise_degrees=$OBJECT_STATE_ROTATION_NOISE_DEG \
    env.domain_randomization.joint_velocity_obs_noise_std=$JOINT_VELOCITY_OBS_NOISE_STD \
    "env.domain_randomization.object_scale_noise_multiplier_range=$OBJECT_SCALE_NOISE_RANGE" \
    env.reset.reset_position_noise_x=$RESET_POSITION_NOISE_X \
    env.reset.reset_position_noise_y=$RESET_POSITION_NOISE_Y \
    env.reset.reset_position_noise_z=$RESET_POSITION_NOISE_Z \
    env.reset.reset_dof_pos_random_interval_arm=$RESET_DOF_POS_NOISE_ARM \
    env.reset.reset_dof_pos_random_interval_fingers=$RESET_DOF_POS_NOISE_FINGERS \
    env.reset.reset_dof_vel_random_interval=$RESET_DOF_VEL_NOISE \
    env.reset.table_reset_z_range=$TABLE_RESET_Z_RANGE \
    env.reward.lifting_rew_scale=$LIFTING_REW_SCALE \
    env.reward.lifting_bonus=$LIFTING_BONUS \
    env.termination.force_consecutive_near_goal_steps=$FORCE_CONSECUTIVE_NEAR_GOAL \
    agent.params.config.max_epochs=$MAX_ITERATIONS \
    agent.params.config.minibatch_size=$MINIBATCH_SIZE \
    agent.params.config.central_value_config.minibatch_size=$MINIBATCH_SIZE \
    agent.params.config.expl_coef_block_size=$EXPL_COEF_BLOCK_SIZE \
    agent.params.config.name="0_${EXPERIMENT_NAME}" \
    agent.params.seed=$SEED \
    hydra.run.dir="$HYDRA_RUN_DIR"
