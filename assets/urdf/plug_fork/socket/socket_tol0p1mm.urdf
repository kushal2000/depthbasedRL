<?xml version="1.0"?>
<!--
  Power board receptacle, 0.1 mm clearance per side.

  A power strip rather than a wall socket, because the receptacle has to
  sit on a table: a wall outlet mounted on a table top is incoherent, and
  earlier attempts to model one (with a wall panel, then a faceplate over
  a body) imitated an installation that does not exist in this scene.

  Blade slots at x = +/-6.35 mm, 1.6 mm wide, opening into the body so a
  plug can seat its full 15.9 mm blade depth. Collision is exact boxes;
  the visual carries the aluminium sleeve, plastic chassis, switch and
  cable. Only the ACTIVE outlet is opened in collision - the companion
  outlet is visual, so nothing can enter it.

  Block 120 x 56 x 30 mm, origin at its
  centroid, so the Problem uses hole_z_offset = 0.0150.
-->
<robot name="socket_tol0p1mm">
  <link name="hole">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="socket_tol0p1mm_visual.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 -0.011950" rpy="0 0 0"/>
      <geometry><box size="0.120000 0.056000 0.006100"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.035125 0.000000 0.001050" rpy="0 0 0"/>
      <geometry><box size="0.049750 0.056000 0.019900"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.035125 0.000000 0.001050" rpy="0 0 0"/>
      <geometry><box size="0.049750 0.056000 0.019900"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.000000 0.018600 0.001050" rpy="0 0 0"/>
      <geometry><box size="0.020500 0.018800 0.019900"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.000000 -0.018600 0.001050" rpy="0 0 0"/>
      <geometry><box size="0.020500 0.018800 0.019900"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.033625 0.000000 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.052750 0.056000 0.004000"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.000000 0.000000 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.010900 0.056000 0.004000"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.033625 0.000000 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.052750 0.056000 0.004000"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.006350 0.015700 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.001800 0.024600 0.004000"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.006350 -0.015700 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.001800 0.024600 0.004000"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.006350 0.016100 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.001800 0.023800 0.004000"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.006350 -0.016100 0.013000" rpy="0 0 0"/>
      <geometry><box size="0.001800 0.023800 0.004000"/></geometry>
    </collision>
    <inertial>
      <mass value="0.290976"/>
      <origin xyz="0.000000 0.000000 -0.000048" rpy="0 0 0"/>
      <inertia ixx="1.009761e-04" ixy="1.225264e-21" ixz="-1.431727e-09" iyy="3.847464e-04" iyz="-3.311896e-22" izz="4.411877e-04"/>
    </inertial>
  </link>
</robot>
